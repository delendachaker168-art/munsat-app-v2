{
  "expo": {
    "name": "منصت",
    "slug": "munsat",
    "scheme": "munsat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "السماح لمنصت باستخدام الميكروفون لتسجيل الرسائل الصوتية."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح لمنصت باختيار صورة الملف الشخصي."
        }
      ],
      [
        "react-native-vosk",
        {
          "iOSMicrophonePermission": "يحتاج منصت إلى الميكروفون للتعرف على الأوامر الصوتية محليًا."
        }
      ],
      "react-native-zip-archive",
      "./plugins/with-munsat-foreground-service"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.delendasmartsolutions.munsat",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.delendasmartsolutions.munsat",
      "deploymentTarget": "15.5"
    },
    "owner": "delendachaker168",
    "extra": {
      "eas": {
        "projectId": "72bcefd6-703f-4deb-a741-b6ef639cf4a4"
      }
    }
  }
}
